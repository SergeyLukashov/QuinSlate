<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="QuinSlate.Ui.Components.SearchPillView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuinSlate.Ui.Components"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- The search pill (Docs/Specs/24-SEARCH.md § The pill): a small floating bar at the top-right of
         the editor. Declared after EditorHostContent in BufferPanel.xaml so it paints over the
         WebView2, as LimitNoticeView does. The UserControl and PillRoot carry no background, so only
         the pill itself takes pointer input; the rest of the editor stays clickable.

         The container is the tab-edit flyout's presenter chrome: the stock FlyoutPresenter
         background (in-app acrylic), border brush and thickness, OverlayCornerRadius (8, as
         TabEditFlyout sets), and its 8px inset before the glyph; the other edges are 4px so the
         pill stays one button high. The glyph is primary text spaced from the text as
         LimitNoticeView's is. The shadow is a hand-rolled Composition DropShadow
         (PillDropShadow): a ThemeShadow has no XAML receiver behind it and would draw nothing over
         the WebView2. -->

    <UserControl.Resources>
        <ResourceDictionary>
        <!-- Hover and press use the subtle fills, per theme, so the buttons read like the
             title-bar cluster rather than standard buttons. -->
        <ResourceDictionary.ThemeDictionaries>
            <ResourceDictionary x:Key="Default">
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="Light">
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
            </ResourceDictionary>
            <ResourceDictionary x:Key="HighContrast">
                <StaticResource x:Key="ButtonBackgroundPointerOver" ResourceKey="SystemColorHighlightColorBrush" />
                <StaticResource x:Key="ButtonBackgroundPressed" ResourceKey="SystemColorHighlightColorBrush" />
            </ResourceDictionary>
        </ResourceDictionary.ThemeDictionaries>

        <x:Double x:Key="PillButtonSize">28</x:Double>
        <x:Double x:Key="PillGlyphSize">12</x:Double>
        <x:Double x:Key="SearchGlyphSize">14</x:Double>
        <x:Double x:Key="PillFontSize">13</x:Double>
        <x:Double x:Key="CounterFontSize">12</x:Double>
        <!-- The query box is as tall as the buttons (not the TextBox's 32px default), so the row is one
             button high and this padding is the gap around the close button on every edge. The left
             side keeps the tab-edit flyout's 8px presenter inset before the search glyph. -->
        <Thickness x:Key="PillPadding">8,4,4,4</Thickness>
        <Thickness x:Key="PillRootMargin">0,12,15,0</Thickness>
        <Thickness x:Key="CounterMargin">6,0,4,0</Thickness>
        <!-- The TextBox template pins its text to the top padding rather than centring it, so the
             vertical padding is what centres a 13px line in the PillButtonSize-high box. -->
        <Thickness x:Key="QueryBoxPadding">9,5,4,5</Thickness>

        <!-- Lightweight styling: the buttons are transparent at rest like the title-bar cluster,
             including while disabled, and only the standard subtle fill shows on hover/press. -->
        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />

        <!-- A borderless box: the pill is the field's chrome, so the TextBox draws no fill, border, or
             focus underline of its own in any state. -->
        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>

        <!-- The buttons never take focus from a click (AllowFocusOnInteraction="False" on each), so
             clicking next or previous leaves the caret in the box and Enter keeps working; Tab still
             reaches them from the keyboard. -->
        <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Width" Value="{StaticResource PillButtonSize}" />
            <Setter Property="Height" Value="{StaticResource PillButtonSize}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="PillRoot"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Margin="{StaticResource PillRootMargin}"
          Visibility="Collapsed">

        <!-- "No results" stays calm: the counter only turns muted — no red box, shake, or sound. -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="CounterStates">
                <VisualState x:Name="CounterNormal" />
                <VisualState x:Name="CounterMuted">
                    <VisualState.Setters>
                        <Setter Target="CounterText.Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- Empty, transparent, sized to the pill by the Grid stretch. Hosts the Composition drop
             shadow; declared first so the shadow paints behind the pill. -->
        <Border x:Name="ShadowHost" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ShadowSlide" />
            </Border.RenderTransform>
        </Border>

        <Border x:Name="PillHost"
                Padding="{StaticResource PillPadding}"
                Background="{ThemeResource FlyoutPresenterBackground}"
                BorderBrush="{ThemeResource FlyoutBorderThemeBrush}"
                BorderThickness="{ThemeResource FlyoutBorderThemeThickness}"
                CornerRadius="{ThemeResource OverlayCornerRadius}"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PillSlide" />
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <FontIcon Grid.Column="0"
                          Glyph="&#xE721;"
                          FontSize="{StaticResource SearchGlyphSize}"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                          VerticalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />

                <TextBox x:Name="QueryBox"
                         Grid.Column="1"
                         MinWidth="0"
                         MinHeight="{StaticResource PillButtonSize}"
                         Padding="{StaticResource QueryBoxPadding}"
                         FontSize="{StaticResource PillFontSize}"
                         VerticalAlignment="Center"
                         PlaceholderText="Search all slates"
                         IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"
                         AutomationProperties.Name="Search all slates" />

                <TextBlock x:Name="CounterText"
                           Grid.Column="2"
                           Margin="{StaticResource CounterMargin}"
                           FontSize="{StaticResource CounterFontSize}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />

                <Button x:Name="PreviousButton"
                        Grid.Column="3"
                        Style="{StaticResource PillButtonStyle}"
                        AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="Previous match (Shift+Enter)"
                        AutomationProperties.Name="Previous match">
                    <FontIcon Glyph="&#xE70E;" FontSize="{StaticResource PillGlyphSize}" />
                </Button>
                <Button x:Name="NextButton"
                        Grid.Column="4"
                        Style="{StaticResource PillButtonStyle}"
                        AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="Next match (Enter)"
                        AutomationProperties.Name="Next match">
                    <FontIcon Glyph="&#xE70D;" FontSize="{StaticResource PillGlyphSize}" />
                </Button>
                <Button x:Name="CloseButton"
                        Grid.Column="5"
                        Style="{StaticResource PillButtonStyle}"
                        AllowFocusOnInteraction="False"
                        ToolTipService.ToolTip="Close (Esc)"
                        AutomationProperties.Name="Close search">
                    <FontIcon Glyph="&#xE711;" FontSize="{StaticResource PillGlyphSize}" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
